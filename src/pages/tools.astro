---
import Layout from "../layouts/Layout.astro";

const stack = [
  {
    category: "Languages",
    items: [
      {
        name: "Node.js",
        desc: "Primary runtime for backend services and APIs.",
        url: "https://nodejs.org",
      },
      {
        name: "Python",
        desc: "Data pipelines, automation, and ML tooling.",
        url: "https://python.org",
      },
      {
        name: "TypeScript",
        desc: "Typed superset of JS used across the entire stack.",
        url: "https://www.typescriptlang.org",
      },
    ],
  },
  {
    category: "Frameworks",
    items: [
      {
        name: "React",
        desc: "Component-driven UIs for web applications.",
        url: "https://react.dev",
      },
      {
        name: "Astro",
        desc: "Static-first framework powering this very site.",
        url: "https://astro.build",
      },
      {
        name: "Hono",
        desc: "Ultra-fast, lightweight web framework for edge & serverless.",
        url: "https://hono.dev",
      },
    ],
  },
  {
    category: "Platforms & Infrastructure",
    items: [
      {
        name: "Cloudflare",
        desc: "CDN, DNS, Workers, R2, D1 — our primary edge platform.",
        url: "https://cloudflare.com",
      },
      {
        name: "Fly.io",
        desc: "Global application deployment close to users.",
        url: "https://fly.io",
      },
      {
        name: "GitHub Actions",
        desc: "CI/CD pipelines for automated deployments.",
        url: "https://github.com/features/actions",
      },
    ],
  },
  {
    category: "Message Queues",
    items: [
      {
        name: "RabbitMQ",
        desc: "Reliable message broker for async task processing.",
        url: "https://rabbitmq.com",
      },
      {
        name: "LavinMQ",
        desc: "High-performance, lightweight AMQP message queue.",
        url: "https://lavinmq.com",
      },
    ],
  },
  {
    category: "Databases",
    items: [
      {
        name: "PostgreSQL",
        desc: "Relational database for structured, transactional data.",
        url: "https://postgresql.org",
      },
      {
        name: "Redis",
        desc: "In-memory store for caching, sessions, and pub/sub.",
        url: "https://redis.io",
      },
      {
        name: "SQLite",
        desc: "Embedded DB for lightweight and edge deployments.",
        url: "https://sqlite.org",
      },
      {
        name: "MySQL",
        desc: "Battle-tested relational database for web applications.",
        url: "https://mysql.com",
      },
      {
        name: "ClickHouse",
        desc: "Columnar OLAP database for analytics at massive scale.",
        url: "https://clickhouse.com",
      },
    ],
  },
  {
    category: "Dev Tools",
    items: [
      {
        name: "VS Code",
        desc: "Primary code editor across the team.",
        url: "https://code.visualstudio.com",
      },
      {
        name: "Docker",
        desc: "Containerization for consistent dev and prod environments.",
        url: "https://docker.com",
      },
      {
        name: "Bun",
        desc: "Fast all-in-one JS runtime and package manager.",
        url: "https://bun.sh",
      },
      {
        name: "pnpm",
        desc: "Fast, disk-efficient Node.js package manager.",
        url: "https://pnpm.io",
      },
    ],
  },
];
---

<Layout
  title="Tech Stack — Accustra Labs"
  description="The languages, frameworks, databases, and platforms powering everything we build at Accustra Labs."
>
  <article class="stack-article">
    <header class="page-header">
      <h1 class="page-title">Tech Stack</h1>
      <p class="subtitle">
        The languages, frameworks, databases, and platforms we rely on to ship
        fast, reliable products.
      </p>
    </header>

    <div class="stack-list">
      {
        stack.map((group) => (
          <div class="stack-group">
            <div class="group-header">
              <span class="category">{group.category}</span>
            </div>
            {group.items.map((item) => (
              <div class="stack-row">
                {/* <span class="item-icon">
                  <svg
                    aria-hidden="true"
                    width="18"
                    height="18"
                    viewBox="0 0 512 512"
                    fill="currentColor"
                  >
                    <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8l164.9-188.5L26.8 48h145.6l100.5 132.9zm-24.8 373.8h39.1L151.1 88h-42z" />
                  </svg>
                </span> */}
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="item-name"
                >
                  {item.name}
                </a>
                <span class="item-sep"> — </span>
                <span class="item-desc">{item.desc}</span>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </article>
</Layout>

<style>
  .page-title {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .subtitle {
    font-size: 20px;
    color: #aaaaaa;
    margin-bottom: 40px;
  }

  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 35px;
  }

  .stack-group {
    display: flex;
    flex-direction: column;
  }

  .group-header {
    padding-bottom: 12px;
    margin-bottom: 0;
  }

  .category {
    font-size: 15px;
    color: var(--accent-color);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* .stack-row {
    padding: 10px 0;
    font-size: 18px;
    line-height: 1.5;
  } */

  .stack-row {
    display: flex;
    align-items: center;
    gap: 8px;

    padding: 10px 0;
    font-size: 18px;
    line-height: 1.5;
  }
  .stack-group .stack-row:first-of-type {
    border-top: 1px solid #313131;
  }

  .item-name {
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
  }

  .item-name:hover {
    color: var(--text-muted);
  }

  .item-sep {
    color: #444;
  }

  .item-desc {
    color: #cccccc;
  }

  .item-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .item-icon svg {
    display: block;
  }
</style>
