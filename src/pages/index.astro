---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Accustra Labs - We build softwares and APIs for marketers.">
  <article class="home-article">
    <h1 class="home-title">
      We build <span class="underline">softwares </span> and <span
        class="underline">APIs</span
      > for marketers.
    </h1>

    <div class="bio-container">
      <p class="bio-paragraph">
        Accustra Labs is an independent software company founded by marketers
        for marketers. Led by a founder with over a decade of experience in
        digital marketing, we build APIs and software that help businesses grow
        online. We're a small, self-funded team that believes great products
        come from solving real problems, listening to customers, and improving a
        little every day.
      </p>
    </div>

    <div class="product-grid">
      <!-- serphelp -->
      <div class="product-row">
        <div class="product-icon">
          <a
            href="https://chromewebstore.google.com/detail/serp-help-extract-serp-da/gmcngibkcicdgkpnpmmibblamnbaalhh"
            target="_blank"
            rel="nofollow noreferrer noopener"
          >
            <img
              src="/images/serphelp.svg"
              alt="serphelp"
              width="85"
              height="77"
            />
          </a>
        </div>
        <div class="product-info">
          <h3>
            <a
              href="https://chromewebstore.google.com/detail/serp-help-extract-serp-da/gmcngibkcicdgkpnpmmibblamnbaalhh"
              target="_blank"
              rel="nofollow noreferrer noopener">serphelp</a
            >
            <span class="badge badge-live"
              ><span class="badge-dot"></span>Live</span
            >
          </h3>
          <p>
            Search engine auto suggest keywords can be extracted one by one or
            in bulk. You can save these keywords into a bucket before you copy
            them to the clipboard. You can also clear the bucket. Currently
            supports Google search.
          </p>
        </div>
      </div>

      <!-- rapidapi -->
      <div class="product-row">
        <div class="product-icon">
          <a
            href="https://rapidapi.com/user/zeu.thunder"
            target="_blank"
            rel="nofollow noopener noreferrer"
          >
            <img
              src="/images/rapidapi.png"
              alt="rapidapi"
              width="85"
              height="61"
            />
          </a>
        </div>
        <div class="product-info">
          <h3>
            <a
              href="https://rapidapi.com/user/zeu.thunder"
              target="_blank"
              rel="noopener noreferrer nofollow">rapidapi collection</a
            >
            <span class="badge badge-live"
              ><span class="badge-dot"></span>Live</span
            >
          </h3>
          <p>
            A collection of APIs for developers to use in their own
            applications.
          </p>
        </div>
      </div>

      <!-- ytcrawl -->
      <div class="product-row">
        <div class="product-icon">
          <a
            href="https://ytcrawl.com"
            target="_blank"
            rel="nofollow noreferrer noopener"
          >
            <img
              src="/images/ytcrawl.svg"
              alt="ytcrawl"
              width="78"
              height="75"
            />
          </a>
        </div>
        <div class="product-info">
          <h3>
            <a
              href="https://ytcrawl.com"
              target="_blank"
              rel="nofollow noreferrer noopener">ytcrawl</a
            >
            <span class="badge badge-soon">Coming Soon</span>
          </h3>
          <p>
            The world's largest YouTube channels dataset with subscriber count,
            views, videos, creation date, and more. Access it through our API,
            downloadable datasets, or interactive web app.
          </p>
        </div>
      </div>
      <!-- bulkprops -->
      <div class="product-row">
        <div class="product-icon">
          <a
            href="https://bulkprops.com"
            target="_blank"
            rel="nofollow noreferrer noopener"
          >
            <img
              src="/images/bulkprops.svg"
              alt="bulkprops"
              width="78"
              height="75"
            />
          </a>
        </div>
        <div class="product-info">
          <h3>
            <a
              href="https://bulkprops.com"
              target="_blank"
              rel="nofollow noreferrer noopener">bulkprops</a
            >
            <span class="badge badge-soon">Coming Soon</span>
          </h3>
          <p>
            Bulk extract domain metrics and SEO signals including DR, DA,
            backlinks, traffic estimates, and index status. Access results
            instantly through our API, web app, or downloadable datasets.
          </p>
        </div>
      </div>
    </div>
  </article>
</Layout>
