---
import Layout from "../layouts/Layout.astro";
import Bio from "../components/Bio.astro";
---

<Layout title="Swaraj Sahu - Web Developer and Digital Marketer">
  <article class="home-article">
    <div class="profile-picture-frame">
      <img
        src="/swaraj-toon-gold.png"
        alt="Profile picture"
        width="400"
        height="400"
      />
    </div>
    <h1 class="home-title">
      <span class="underline">Hello'</span>, I'm Swaraj
    </h1>
    <div class="bio-container">
      <Bio />
    </div>
  </article>
</Layout>

<style>
  .profile-picture-frame {
    width: 184px;
    height: 184px;
    margin: -14px auto 34px;
    padding: 6px;
    border-radius: 50%;
    background: #262626;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .profile-picture-frame img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .profile-picture-frame {
      width: 160px;
      height: 160px;
    }
  }
</style>
