---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blogs");
const posts = allPosts.map((post) => ({
  title: post.data.title,
  date: post.data.date,
  excerpt: post.data.excerpt,
  category: post.data.category,
  url: `/blog/${post.id}`,
}));
---

<Layout
  title="Blog - Accustralabs"
  description="Actionable articles on web performance, WordPress development, and system design."
>
  <article class="blog-article">
    <header class="page-header">
      <h1 class="page-title">Blog</h1>
      <p class="subtitle">
        Actionable articles on web performance, WordPress development, and
        agency growth.
      </p>
    </header>

    <div class="posts-list">
      {
        posts.map((post) => (
          <div class="post-card">
            <div class="post-meta">
              <span class="category">{post.category}</span> &bull;{" "}
              <time>{post.date}</time>
            </div>
            <h2>
              <a href={post.url}>{post.title}</a>
            </h2>
            <p>{post.excerpt}</p>
          </div>
        ))
      }
    </div>
  </article>
</Layout>

<style>
  .page-title {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .subtitle {
    font-size: 20px;
    color: #aaaaaa;
    margin-bottom: 40px;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 35px;
  }

  .post-card {
    padding-bottom: 30px;
    border-bottom: 1px solid #313131;
  }

  .post-meta {
    font-size: 15px;
    color: #888888;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .category {
    color: var(--accent-color);
    font-weight: 600;
  }

  .post-card h2 {
    font-size: 26px;
    margin-bottom: 10px;
  }

  .post-card h2 a {
    color: #ffffff;
    text-decoration: none;
  }

  .post-card h2 a:hover {
    color: var(--text-muted);
    text-decoration: underline;
  }

  .post-card p {
    font-size: 18px;
    color: #cccccc;
    line-height: 1.6;
  }
</style>
