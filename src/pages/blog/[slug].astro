---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blogs');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - Accustra Labs`} description={post.data.excerpt}>
  <article class="blog-article">
    <header class="page-header">
      <div class="post-meta">
        <span class="category">{post.data.category}</span> &bull; <time>{post.data.date}</time>
      </div>
      <h1 class="page-title">{post.data.title}</h1>
      <p class="subtitle">{post.data.excerpt}</p>
    </header>

    <div class="post-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .page-header {
    margin-bottom: 40px;
  }

  .post-meta {
    font-size: 15px;
    color: #888888;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .category {
    color: var(--accent-color);
    font-weight: 600;
  }

  .page-title {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 20px;
    color: #aaaaaa;
    line-height: 1.6;
    margin-bottom: 0;
  }

  .post-content {
    max-width: 740px;
    margin: 0 auto;
  }

  .post-content :global(h2) {
    font-size: 28px;
    font-weight: 700;
    margin-top: 40px;
    margin-bottom: 16px;
    color: #ffffff;
  }

  .post-content :global(h3) {
    font-size: 22px;
    font-weight: 600;
    margin-top: 30px;
    margin-bottom: 12px;
    color: #ffffff;
  }

  .post-content :global(p) {
    font-size: 18px;
    color: #cccccc;
    line-height: 1.75;
    margin-bottom: 20px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    font-size: 18px;
    color: #cccccc;
    line-height: 1.75;
    padding-left: 24px;
    margin-bottom: 20px;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
  }

  .post-content :global(code) {
    background: #1e1e1e;
    color: var(--accent-color);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'Courier New', monospace;
  }

  .post-content :global(pre) {
    background: #1a1a1a;
    border: 1px solid #313131;
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: #e0e0e0;
    font-size: 15px;
  }

  .post-content :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid #313131;
    margin: 40px 0;
  }
</style>
