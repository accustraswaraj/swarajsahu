---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact - Swaraj Sahu"
  description="Get in touch with the team at Swaraj Sahu."
>
  <article class="contact-article">
    <header class="page-header">
      <h1 class="page-title">Contact</h1>
      <p class="subtitle">
        Have a question about our softwares & APIs, feedback, or business
        inquiries? Drop us a line below.
      </p>
    </header>

    <div class="contact-grid">
      <div class="contact-sidebar">
        <h3>Connect Directly</h3>
        <p>You can also reach out or follow us on our official channels:</p>

        <ul class="contact-info-list">
          <li>
            <strong>X (Twitter):</strong>
            <a
              href="https://x.com/botsboss"
              target="_blank"
              rel="noopener noreferrer">@botsboss</a
            >
          </li>
          <li>
            <strong>Support:</strong> For email support, please mail us at <a
              href="mailto:swaraj@accustra.com"
              target="_blank"
              rel="noopener noreferrer">swaraj@accustra.com</a
            >.
          </li>
        </ul>
      </div>
    </div>
  </article>
</Layout>

<style>
  .page-title {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .subtitle {
    font-size: 20px;
    color: #aaaaaa;
    margin-bottom: 40px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 50px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group label {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 16px;
    background-color: #262626;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
    color: #ffffff;
    font-family: inherit;
    font-size: 16px;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #4a89dd;
  }

  .submit-btn {
    align-self: flex-start;
    padding: 12px 28px;
    background-color: #ffffff;
    color: #1d1d1d;
    font-weight: 700;
    font-size: 16px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .submit-btn:hover {
    opacity: 0.85;
  }

  .contact-sidebar h3 {
    font-size: 24px;
    margin-bottom: 15px;
  }

  .contact-sidebar p {
    color: #cccccc;
    margin-bottom: 20px;
    font-size: 17px;
  }

  .contact-info-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .contact-info-list li {
    font-size: 17px;
    color: #cccccc;
  }

  .contact-info-list a {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
