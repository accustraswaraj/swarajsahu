---

---

<header class="site-header">
  <div class="inside-header grid-container">
    <div class="header-main">
      <div class="site-logo">
        <a href="/" rel="home" title="Accustra Labs" class="logo-link">
          <img
            src="/accustralabs.svg"
            alt="Accustra Labs"
            class="logo-image"
            width="40"
            height="40"
          />
          <span class="logo-text">Accustra Labs</span>
        </a>
      </div>

      <nav class="desktop-nav" aria-label="Primary Navigation">
        <ul class="nav-menu">
          <li><a href="/tools">Technologies</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact</a></li>
          <li class="social-icon">
            <a
              href="https://x.com/accustra_com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X (Twitter)"
            >
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 512 512"
                fill="currentColor"
              >
                <path
                  d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8l164.9-188.5L26.8 48h145.6l100.5 132.9zm-24.8 373.8h39.1L151.1 88h-42z"
                ></path>
              </svg>
            </a>
          </li>
          <li class="social-icon">
            <a
              href="https://buymeacoffee.com/accustra"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Buy Me a Coffee"
            >
              <svg
                aria-hidden="true"
                width="20"
                height="18"
                viewBox="0 0 640 512"
                fill="currentColor"
              >
                <path
                  d="M192 384h192c53 0 96-43 96-96h32c70.6 0 128-57.4 128-128S582.6 32 512 32H120c-13.3 0-24 10.7-24 24v232c0 53 43 96 96 96M512 96c35.3 0 64 28.7 64 64s-28.7 64-64 64h-32V96zm47.7 384H48.3c-47.6 0-61-64-36-64h583.3c25 0 11.8 64-35.9 64"
                ></path>
              </svg>
            </a>
          </li>
        </ul>
      </nav>

      <button
        id="mobile-toggle"
        class="menu-toggle"
        aria-expanded="false"
        aria-label="Toggle Navigation"
      >
        <svg viewBox="0 0 512 512" width="22" height="22" fill="currentColor">
          <path
            d="M0 96c0-13.255 10.745-24 24-24h464c13.255 0 24 10.745 24 24s-10.745 24-24 24H24c-13.255 0-24-10.745-24-24zm0 160c0-13.255 10.745-24 24-24h464c13.255 0 24 10.745 24 24s-10.745 24-24 24H24c-13.255 0-24-10.745-24-24zm0 160c0-13.255 10.745-24 24-24h464c13.255 0 24 10.745 24 24s-10.745 24-24 24H24c-13.255 0-24-10.745-24-24z"
          ></path>
        </svg>
        <span class="menu-text">Menu</span>
      </button>
    </div>

    <div id="mobile-menu" class="mobile-nav hidden">
      <ul class="mobile-nav-menu">
        <li><a href="/tools">Tech Stack</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/contact">Contact</a></li>
        <li class="social-links-mobile">
          <a
            href="https://x.com/accustra_com"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X (Twitter)"
          >
            <svg
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 512 512"
              fill="currentColor"
            >
              <path
                d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8l164.9-188.5L26.8 48h145.6l100.5 132.9zm-24.8 373.8h39.1L151.1 88h-42z"
              ></path>
            </svg>
          </a>
          <a
            href="https://buymeacoffee.com/accustra"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Buy Me a Coffee"
          >
            <svg
              aria-hidden="true"
              width="22"
              height="20"
              viewBox="0 0 640 512"
              fill="currentColor"
            >
              <path
                d="M192 384h192c53 0 96-43 96-96h32c70.6 0 128-57.4 128-128S582.6 32 512 32H120c-13.3 0-24 10.7-24 24v232c0 53 43 96 96 96M512 96c35.3 0 64 28.7 64 64s-28.7 64-64 64h-32V96zm47.7 384H48.3c-47.6 0-61-64-36-64h583.3c25 0 11.8 64-35.9 64"
              ></path>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    padding-top: 25px;
    padding-bottom: 25px;
  }

  .header-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-logo {
    display: flex;
    align-items: center;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .logo-image {
    height: 36px;
    width: 36px;
    display: block;
    /* Recolor the SVG to Tailwind green-400 (#4ade80) */
    filter: invert(72%) sepia(55%) saturate(497%) hue-rotate(82deg)
      brightness(101%) contrast(97%);
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 25px;
  }

  .nav-menu li a {
    color: #ffffff;
    text-decoration: none;
    font-size: 18px;
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .nav-menu li a:hover {
    opacity: 0.75;
  }

  .social-icon a {
    display: flex;
    align-items: center;
    color: #ffffff;
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    font-size: 18px;
    align-items: center;
    gap: 8px;
  }

  .mobile-nav {
    display: none;
    margin-top: 15px;
    border-top: 1px solid #313131;
    padding-top: 15px;
  }

  .mobile-nav.hidden {
    display: none;
  }

  .mobile-nav-menu {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .mobile-nav-menu li a {
    color: #ffffff;
    text-decoration: none;
    font-size: 18px;
    display: block;
    line-height: 40px;
  }

  .social-links-mobile {
    display: flex;
    gap: 20px;
    align-items: center;
    padding-top: 10px;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .mobile-nav:not(.hidden) {
      display: block;
    }

    .logo-image {
      height: 30px;
      width: 30px;
    }

    .logo-text {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById("mobile-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", (!isExpanded).toString());
      mobileMenu.classList.toggle("hidden");
    });
  }
</script>
